parameters:
	ignoreErrors:
		-
			message: '#^Offset ''App\\\\Models\\\\Admin''\|''App\\\\Models\\\\Attachment''\|''App\\\\Models\\\\Attendance''\|''App\\\\Models\\\\Conversation''\|''App\\\\Models\\\\Feedback''\|''App\\\\Models\\\\Lecturer''\|''App\\\\Models\\\\Logbook''\|''App\\\\Models\\\\Message''\|''App\\\\Models\\\\Student''\|''App\\\\Models\\\\Supervisor''\|''App\\\\Models\\\\Todo''\|''App\\\\Models\\\\UserNotification'' on array\{App\\Models\\Admin\: array\{''admins'', ''admin_id''\}, App\\Models\\Lecturer\: array\{''lecturers'', ''lecturer_id''\}, App\\Models\\Supervisor\: array\{''supervisors'', ''supervisor_id''\}, App\\Models\\Student\: array\{''students'', ''student_id''\}, App\\Models\\Logbook\: array\{''logbooks'', ''logbook_id''\}, App\\Models\\Attachment\: array\{''attachments'', ''attachment_id''\}, App\\Models\\Feedback\: array\{''feedback'', ''feedback_id''\}, App\\Models\\Conversation\: array\{''conversations'', ''conversation_id''\}, \.\.\.\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: app/Console/Commands/CleanupDummyData.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 2
			path: app/Console/Commands/CleanupDummyData.php

		-
			message: '#^Strict comparison using \=\=\= between \*NEVER\* and ''user_notifications'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Console/Commands/CleanupDummyData.php

		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: app/Exports/InternshipSheets.php

		-
			message: '#^Parameter \#1 \$boolean of function abort_unless expects bool, App\\Models\\Admin\|App\\Models\\Lecturer\|App\\Models\\Student\|App\\Models\\Supervisor\|App\\Models\\User\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/NotificationController.php

		-
			message: '#^Access to an undefined property App\\Models\\Student\:\:\$internship_role\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Student/LogbookController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,App\\Models\\Logbook\>\:\:filter\(\) expects \(callable\(App\\Models\\Logbook, int\)\: bool\)\|null, Closure\(mixed\)\: string given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Student/StudentDashboardController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$logbook_id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Supervisor/SupervisorReviewController.php

		-
			message: '#^Parameter \#1 \$logbook of method App\\Services\\NotificationService\:\:reviewGiven\(\) expects App\\Models\\Logbook, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Supervisor/SupervisorReviewController.php

		-
			message: '#^Parameter \#1 \$logbook of method App\\Services\\SupervisorReviewService\:\:save\(\) expects App\\Models\\Logbook, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Supervisor/SupervisorReviewController.php

		-
			message: '#^Call to function filled\(\) with mixed will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Imports/StudentsImport.php

		-
			message: '#^Access to an undefined property App\\Models\\Conversation\:\:\$unread_count\.$#'
			identifier: property.notFound
			count: 2
			path: app/Services/ChatContacts.php

		-
			message: '#^Access to an undefined property App\\Models\\UserNotification\:\:\$merged_count\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/NotificationService.php

		-
			message: '#^Access to an undefined property App\\Models\\UserNotification\:\:\$read_at\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/NotificationService.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$conversation_id\.$#'
			identifier: property.notFound
			count: 3
			path: app/Services/NotificationService.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$lecturer\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/NotificationService.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$student\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/NotificationService.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$supervisor\.$#'
			identifier: property.notFound
			count: 1
			path: app/Services/NotificationService.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,App\\Models\\Todo\>\:\:filter\(\) expects \(callable\(App\\Models\\Todo, int\)\: bool\)\|null, Closure\(mixed\)\: \(Carbon\\Carbon\|null\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/ReminderService.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Services/SupervisorRubricService.php
